{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd nirmal-enterprises && npm install && npm run build",
  "outputDirectory": "nirmal-enterprises/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
